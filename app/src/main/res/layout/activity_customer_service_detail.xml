<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/customerServiceDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ========================================
         1. TOOLBAR
         ======================================== -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCustomerServiceDetail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        app:title="Chi tiết dịch vụ"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_guest_branch_back"
        app:navigationIconTint="@color/primary" />

    <!-- ========================================
         2. NỘI DUNG CÓ THỂ CUỘN
         ======================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ========================================
                 3. HÌNH ẢNH DỊCH VỤ
                 ======================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/primary_light"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="190dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imgCustomerDetailService"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_splash_scissors"
                        android:contentDescription="Biểu tượng dịch vụ"
                        app:tint="@color/primary" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========================================
                 4. TÊN DỊCH VỤ
                 ======================================== -->

            <TextView
                android:id="@+id/txtCustomerDetailServiceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Cắt tóc nam"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- ========================================
                 5. DANH MỤC DỊCH VỤ
                 ======================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/primary_light"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/txtCustomerDetailServiceCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="Cắt tóc"
                    android:textColor="@color/primary_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <!-- ========================================
                 6. MÔ TẢ DỊCH VỤ
                 ======================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Mô tả dịch vụ"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCustomerDetailServiceDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Thông tin mô tả dịch vụ"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

            <!-- ========================================
                 7. THỜI LƯỢNG VÀ GIÁ DỊCH VỤ
                 ======================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_default"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <!-- Thời lượng -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="THỜI LƯỢNG"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCustomerDetailServiceDuration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="30 phút"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Giá dịch vụ -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="GIÁ DỊCH VỤ"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCustomerDetailServicePrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="100.000 đ"
                            android:textColor="@color/primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========================================
                 8. THÔNG TIN CHI NHÁNH ĐÃ CHỌN
                 ======================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCustomerServiceBranch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_default"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CHI NHÁNH ĐÃ CHỌN"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCustomerDetailServiceBranch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Barber Shop - Chi nhánh 01"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========================================
                 9. GHI CHÚ DỮ LIỆU MINH HỌA
                 ======================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="Giá và thời lượng hiện là dữ liệu minh họa."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

    <!-- ========================================
         10. NÚT ĐẶT LỊCH CỐ ĐỊNH
         ======================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:padding="16dp">

        <!-- Hướng dẫn dành cho Customer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Tiếp tục chọn chi nhánh, Barber và thời gian phù hợp."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Nút bắt đầu Booking -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCustomerBookService"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Đặt lịch ngay"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
