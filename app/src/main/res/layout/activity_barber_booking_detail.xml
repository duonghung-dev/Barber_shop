<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/barberBookingDetailRoot"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="@color/background">

    <!-- 1. TOOLBAR -->

    <LinearLayout
        android:id="@+id/toolbarBarberBookingDetail"

        android:layout_width="match_parent"
        android:layout_height="68dp"

        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:paddingStart="12dp"
        android:paddingEnd="12dp"

        android:background="@color/surface">

        <TextView
            android:id="@+id/btnBarberDetailBack"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:gravity="center"

            android:text="←"
            android:textSize="26sp"
            android:textColor="@color/text_primary"

            android:clickable="true"
            android:focusable="true"

            android:contentDescription="Quay lại"

            android:background="?attr/selectableItemBackgroundBorderless"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"
            android:layout_marginStart="6dp"

            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Chi tiết lịch hẹn"

                android:textSize="19sp"
                android:textStyle="bold"

                android:textColor="@color/text_primary"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="Thông tin và trạng thái Booking"

                android:textSize="12sp"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

        <TextView
            android:id="@+id/btnBarberDetailRefresh"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:gravity="center"

            android:text="↻"
            android:textSize="27sp"
            android:textColor="@color/primary"

            android:clickable="true"
            android:focusable="true"

            android:contentDescription="Làm mới chi tiết lịch hẹn"

            android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_default"/>

    <!-- 2. NỘI DUNG VÀ TRẠNG THÁI -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 2.1. NỘI DUNG CUỘN -->

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollBarberBookingDetail"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:fillViewport="true"
            android:clipToPadding="false"

            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <!-- 3. THẺ MÃ BOOKING VÀ TRẠNG THÁI -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBarberDetailOverview"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"

                    app:cardBackgroundColor="@color/primary_light">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:text="Mã lịch hẹn"

                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"/>

                        <TextView
                            android:id="@+id/txtBarberDetailBookingCode"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="5dp"

                            android:text="—"
                            android:textSize="23sp"
                            android:textStyle="bold"

                            android:textColor="@color/primary_dark"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"

                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="12dp"

                            android:background="@color/border_default"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"

                                android:text="Trạng thái lịch hẹn"

                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"/>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipBarberDetailStatus"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="Chưa tải"
                                android:textSize="12sp"

                                android:clickable="false"
                                android:checkable="false"
                                android:focusable="false"

                                app:chipCornerRadius="12dp"
                                app:chipStrokeWidth="0dp"

                                app:chipIconVisible="false"
                                app:checkedIconVisible="false"
                                app:closeIconVisible="false"/>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 4. THÔNG TIN KHÁCH HÀNG -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="12dp"

                    android:text="Thông tin khách hàng"

                    android:textSize="18sp"
                    android:textStyle="bold"

                    android:textColor="@color/text_primary"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"

                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal"
                        android:gravity="center_vertical"

                        android:padding="18dp">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="48dp"

                            android:gravity="center"

                            android:background="@color/primary_light"

                            android:text="👤"
                            android:textSize="23sp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"
                            android:layout_marginStart="14dp"

                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:text="Mã khách hàng"

                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"/>

                            <TextView
                                android:id="@+id/txtBarberDetailCustomerId"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="5dp"

                                android:text="—"
                                android:textSize="16sp"
                                android:textStyle="bold"

                                android:textColor="@color/text_primary"

                                android:maxLines="2"
                                android:ellipsize="end"/>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 5. THÔNG TIN DỊCH VỤ -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="12dp"

                    android:text="Thông tin dịch vụ"

                    android:textSize="18sp"
                    android:textStyle="bold"

                    android:textColor="@color/text_primary"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"

                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:text="Dịch vụ"

                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>

                        <TextView
                            android:id="@+id/txtBarberDetailServiceName"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="5dp"

                            android:text="—"
                            android:textSize="17sp"
                            android:textStyle="bold"

                            android:textColor="@color/text_primary"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"

                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"

                            android:background="@color/border_default"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:text="Barber thực hiện"

                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>

                        <TextView
                            android:id="@+id/txtBarberDetailBarberName"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="5dp"

                            android:text="—"
                            android:textSize="15sp"
                            android:textStyle="bold"

                            android:textColor="@color/text_primary"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"

                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"

                            android:background="@color/border_default"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:text="Chi nhánh"

                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>

                        <TextView
                            android:id="@+id/txtBarberDetailBranchName"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="5dp"

                            android:text="—"
                            android:textSize="15sp"
                            android:textStyle="bold"

                            android:textColor="@color/text_primary"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 6. THỜI GIAN HẸN -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="12dp"

                    android:text="Thời gian lịch hẹn"

                    android:textSize="18sp"
                    android:textStyle="bold"

                    android:textColor="@color/text_primary"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"

                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"

                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"

                                    android:text="Ngày hẹn"

                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"/>

                                <TextView
                                    android:id="@+id/txtBarberDetailBookingDate"

                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"

                                    android:layout_marginTop="7dp"

                                    android:text="—"
                                    android:textSize="16sp"
                                    android:textStyle="bold"

                                    android:textColor="@color/primary_dark"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"

                                android:layout_marginStart="14dp"

                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"

                                    android:text="Giờ hẹn"

                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"/>

                                <TextView
                                    android:id="@+id/txtBarberDetailBookingTime"

                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"

                                    android:layout_marginTop="7dp"

                                    android:text="—"
                                    android:textSize="21sp"
                                    android:textStyle="bold"

                                    android:textColor="@color/primary_dark"/>

                            </LinearLayout>

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"

                            android:layout_marginTop="18dp"
                            android:layout_marginBottom="15dp"

                            android:background="@color/border_default"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"

                                android:text="Thời lượng dịch vụ"

                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"/>

                            <TextView
                                android:id="@+id/txtBarberDetailDuration"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginStart="12dp"

                                android:text="—"

                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"/>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 7. THÔNG TIN THANH TOÁN -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="12dp"

                    android:text="Thông tin thanh toán"

                    android:textSize="18sp"
                    android:textStyle="bold"

                    android:textColor="@color/text_primary"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"

                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal"
                        android:gravity="center_vertical"

                        android:padding="18dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"

                            android:text="Tổng tiền dịch vụ"

                            android:textSize="14sp"
                            android:textStyle="bold"

                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:id="@+id/txtBarberDetailTotalPrice"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginStart="12dp"

                            android:text="—"

                            android:textSize="20sp"
                            android:textStyle="bold"

                            android:textColor="@color/primary_dark"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 8. THÔNG TIN NGHIỆP VỤ -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="22dp"

                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"

                    app:cardBackgroundColor="@color/primary_light">

                    <TextView
                        android:id="@+id/txtBarberDetailStatusMessage"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:padding="16dp"

                        android:text="Thông tin xử lý lịch hẹn sẽ được hiển thị tại đây."

                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp"

                        android:textColor="@color/primary_dark"/>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- 9. TRẠNG THÁI LOADING -->

        <LinearLayout
            android:id="@+id/layoutBarberDetailLoading"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical"
            android:gravity="center"

            android:padding="28dp"

            android:background="@color/background"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="44dp"
                android:layout_height="44dp"

                android:indeterminateTint="@color/primary"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"
                android:gravity="center"

                android:text="Đang tải thông tin lịch hẹn..."

                android:textSize="14sp"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

        <!-- 10. TRẠNG THÁI ERROR -->

        <LinearLayout
            android:id="@+id/layoutBarberDetailError"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical"
            android:gravity="center"

            android:padding="28dp"

            android:background="@color/background"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="⚠"

                android:textSize="42sp"
                android:textColor="@color/primary"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                android:gravity="center"

                android:text="Không thể tải lịch hẹn"

                android:textSize="18sp"
                android:textStyle="bold"

                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/txtBarberDetailError"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="9dp"

                android:gravity="center"

                android:text="Không tìm thấy thông tin lịch hẹn. Vui lòng thử lại."

                android:textSize="14sp"
                android:lineSpacingExtra="4dp"

                android:textColor="@color/text_secondary"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBarberDetailRetry"

                android:layout_width="180dp"
                android:layout_height="48dp"

                android:layout_marginTop="22dp"

                android:text="Thử lại"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"

                android:textColor="@color/surface"

                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp"/>

        </LinearLayout>

    </FrameLayout>

    <!-- 11. KHU VỰC NÚT THAO TÁC -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBarberDetailActions"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:visibility="gone"

        app:cardCornerRadius="0dp"
        app:cardElevation="6dp"

        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <!-- 11.1. XÁC NHẬN BOOKING -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBarberDetailConfirmBooking"

                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:text="Xác nhận lịch hẹn"

                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"

                android:textColor="@color/surface"

                android:visibility="gone"

                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp"/>

            <!-- 11.2. HOÀN THÀNH BOOKING -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBarberDetailCompleteBooking"

                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:text="Đánh dấu hoàn thành"

                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"

                android:textColor="@color/surface"

                android:visibility="gone"

                app:backgroundTint="@color/status_completed"
                app:cornerRadius="12dp"/>

            <!-- 11.3. ĐỀ XUẤT ĐỔI LỊCH -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBarberDetailProposeReschedule"

                android:layout_width="match_parent"
                android:layout_height="48dp"

                android:layout_marginTop="6dp"

                android:text="Đề xuất đổi lịch"

                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"

                android:textColor="@color/primary_dark"

                android:visibility="gone"

                app:backgroundTint="@color/primary_light"
                app:cornerRadius="12dp"
                app:elevation="0dp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
