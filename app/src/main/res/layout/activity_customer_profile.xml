<?xml version="1.0" encoding="utf-8"?>

<!-- ======================================== -->
<!-- STT 22 - CUSTOMER PROFILE               -->
<!-- ======================================== -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/customerProfileRoot"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="@color/background">

    <!-- ======================================== -->
    <!-- 1. THANH TIÊU ĐỀ                       -->
    <!-- ======================================== -->

    <LinearLayout

        android:id="@+id/toolbarCustomerProfile"

        android:layout_width="match_parent"
        android:layout_height="60dp"

        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:paddingStart="12dp"
        android:paddingEnd="20dp"

        android:background="@color/surface">

        <!-- 1.1. NÚT QUAY LẠI -->

        <ImageButton

            android:id="@+id/btnCustomerProfileBack"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:padding="12dp"

            android:src="@drawable/ic_guest_branch_back"

            android:background="?attr/selectableItemBackgroundBorderless"

            android:contentDescription="Quay lại"

            app:tint="@color/text_primary"/>

        <!-- 1.2. TIÊU ĐỀ -->

        <TextView

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:layout_marginStart="8dp"

            android:text="Hồ sơ cá nhân"

            android:textSize="20sp"
            android:textStyle="bold"

            android:textColor="@color/text_primary"/>

    </LinearLayout>

    <!-- ======================================== -->
    <!-- 2. KHUNG NỘI DUNG CHÍNH                 -->
    <!-- ======================================== -->

    <FrameLayout

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1">

        <!-- ======================================== -->
        <!-- 2.1. NỘI DUNG CÓ THỂ CUỘN               -->
        <!-- ======================================== -->

        <androidx.core.widget.NestedScrollView

            android:id="@+id/scrollCustomerProfileContent"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:fillViewport="true"

            android:clipToPadding="false">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

                <!-- ======================================== -->
                <!-- 3. THẺ GIỚI THIỆU CUSTOMER                -->
                <!-- ======================================== -->

                <com.google.android.material.card.MaterialCardView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    app:cardBackgroundColor="@color/primary_light"

                    app:cardCornerRadius="20dp"

                    app:cardElevation="0dp"

                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal"
                        android:gravity="center_vertical"

                        android:padding="20dp">

                        <!-- 3.1. AVATAR CUSTOMER -->

                        <com.google.android.material.card.MaterialCardView

                            android:layout_width="72dp"
                            android:layout_height="72dp"

                            app:cardBackgroundColor="@color/primary"

                            app:cardCornerRadius="36dp"

                            app:cardElevation="0dp">

                            <TextView

                                android:id="@+id/txtCustomerProfileAvatar"

                                android:layout_width="match_parent"
                                android:layout_height="match_parent"

                                android:gravity="center"

                                android:text="KH"

                                android:textSize="24sp"
                                android:textStyle="bold"

                                android:textColor="@color/surface"

                                android:contentDescription="Ảnh đại diện khách hàng"/>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- 3.2. TÊN VÀ EMAIL -->

                        <LinearLayout

                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:layout_marginStart="16dp"

                            android:orientation="vertical">

                            <!-- Tên Customer -->

                            <TextView

                                android:id="@+id/txtCustomerProfileName"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:text="Khách hàng"

                                android:textSize="18sp"
                                android:textStyle="bold"

                                android:textColor="@color/text_primary"

                                android:maxLines="2"

                                android:ellipsize="end"/>

                            <!-- Email Customer -->

                            <TextView

                                android:id="@+id/txtCustomerProfileEmail"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="6dp"

                                android:text="Chưa có email"

                                android:textSize="13sp"

                                android:textColor="@color/text_secondary"

                                android:maxLines="2"

                                android:ellipsize="end"/>

                            <!-- Nhãn vai trò -->

                            <TextView

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="10dp"

                                android:paddingStart="10dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="5dp"

                                android:text="KHÁCH HÀNG"

                                android:textSize="10sp"
                                android:textStyle="bold"

                                android:textColor="@color/primary_dark"

                                android:background="@color/surface"/>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ======================================== -->
                <!-- 4. TIÊU ĐỀ THÔNG TIN CÁ NHÂN              -->
                <!-- ======================================== -->

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"

                    android:text="Thông tin cá nhân"

                    android:textSize="18sp"
                    android:textStyle="bold"

                    android:textColor="@color/text_primary"/>

                <!-- ======================================== -->
                <!-- 5. THẺ THÔNG TIN CÁ NHÂN                  -->
                <!-- ======================================== -->

                <com.google.android.material.card.MaterialCardView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    app:cardBackgroundColor="@color/surface"

                    app:cardCornerRadius="16dp"

                    app:cardElevation="0dp"

                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="vertical"

                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">

                        <!-- ======================================== -->
                        <!-- 5.1. HỌ VÀ TÊN                         -->
                        <!-- ======================================== -->

                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:orientation="vertical"

                            android:paddingTop="18dp"
                            android:paddingBottom="18dp">

                            <TextView

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:text="Họ và tên"

                                android:textSize="12sp"

                                android:textColor="@color/text_secondary"/>

                            <TextView

                                android:id="@+id/txtCustomerProfileFullNameValue"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="6dp"

                                android:text="Chưa cập nhật"

                                android:textSize="15sp"
                                android:textStyle="bold"

                                android:textColor="@color/text_primary"/>

                        </LinearLayout>

                        <!-- ĐƯỜNG PHÂN CÁCH -->

                        <View

                            android:layout_width="match_parent"
                            android:layout_height="1dp"

                            android:background="@color/border_default"/>

                        <!-- ======================================== -->
                        <!-- 5.2. EMAIL                             -->
                        <!-- ======================================== -->

                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:orientation="vertical"

                            android:paddingTop="18dp"
                            android:paddingBottom="18dp">

                            <TextView

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:text="Địa chỉ email"

                                android:textSize="12sp"

                                android:textColor="@color/text_secondary"/>

                            <TextView

                                android:id="@+id/txtCustomerProfileEmailValue"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="6dp"

                                android:text="Chưa cập nhật"

                                android:textSize="15sp"
                                android:textStyle="bold"

                                android:textColor="@color/text_primary"/>

                        </LinearLayout>

                        <!-- ĐƯỜNG PHÂN CÁCH -->

                        <View

                            android:layout_width="match_parent"
                            android:layout_height="1dp"

                            android:background="@color/border_default"/>

                        <!-- ======================================== -->
                        <!-- 5.3. SỐ ĐIỆN THOẠI                     -->
                        <!-- ======================================== -->

                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:orientation="vertical"

                            android:paddingTop="18dp"
                            android:paddingBottom="18dp">

                            <TextView

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:text="Số điện thoại"

                                android:textSize="12sp"

                                android:textColor="@color/text_secondary"/>

                            <TextView

                                android:id="@+id/txtCustomerProfilePhoneValue"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="6dp"

                                android:text="Chưa cập nhật"

                                android:textSize="15sp"
                                android:textStyle="bold"

                                android:textColor="@color/text_primary"/>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ======================================== -->
                <!-- 6. NÚT CHỈNH SỬA HỒ SƠ                    -->
                <!-- ======================================== -->

                <com.google.android.material.button.MaterialButton

                    android:id="@+id/btnCustomerProfileEdit"

                    android:layout_width="match_parent"
                    android:layout_height="52dp"

                    android:layout_marginTop="16dp"

                    android:text="Chỉnh sửa thông tin"

                    android:textSize="15sp"
                    android:textStyle="bold"

                    android:textAllCaps="false"

                    android:textColor="@color/surface"

                    app:backgroundTint="@color/primary"

                    app:cornerRadius="12dp"

                    app:elevation="0dp"/>

                <!-- ======================================== -->
                <!-- 7. TIÊU ĐỀ TIỆN ÍCH TÀI KHOẢN             -->
                <!-- ======================================== -->

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="12dp"

                    android:text="Tiện ích tài khoản"

                    android:textSize="18sp"
                    android:textStyle="bold"

                    android:textColor="@color/text_primary"/>

                <!-- ======================================== -->
                <!-- 8. THẺ TIỆN ÍCH                          -->
                <!-- ======================================== -->

                <com.google.android.material.card.MaterialCardView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    app:cardBackgroundColor="@color/surface"

                    app:cardCornerRadius="16dp"

                    app:cardElevation="0dp"

                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="vertical"

                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <!-- ======================================== -->
                        <!-- 8.1. LỊCH HẸN CỦA TÔI                 -->
                        <!-- ======================================== -->

                        <LinearLayout

                            android:id="@+id/rowCustomerProfileBookings"

                            android:layout_width="match_parent"
                            android:layout_height="64dp"

                            android:orientation="horizontal"
                            android:gravity="center_vertical"

                            android:clickable="true"
                            android:focusable="true"

                            android:background="?attr/selectableItemBackground">

                            <TextView

                                android:layout_width="38dp"
                                android:layout_height="38dp"

                                android:gravity="center"

                                android:text="📅"

                                android:textSize="21sp"/>

                            <TextView

                                android:layout_width="0dp"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"

                                android:layout_marginStart="12dp"

                                android:text="Lịch hẹn của tôi"

                                android:textSize="15sp"

                                android:textColor="@color/text_primary"/>

                            <TextView

                                android:layout_width="24dp"
                                android:layout_height="wrap_content"

                                android:gravity="center"

                                android:text="›"

                                android:textSize="26sp"

                                android:textColor="@color/text_secondary"/>

                        </LinearLayout>

                        <View

                            android:layout_width="match_parent"
                            android:layout_height="1dp"

                            android:background="@color/border_default"/>

                        <!-- ======================================== -->
                        <!-- 8.2. LỊCH SỬ ĐẶT LỊCH                 -->
                        <!-- ======================================== -->

                        <LinearLayout

                            android:id="@+id/rowCustomerProfileHistory"

                            android:layout_width="match_parent"
                            android:layout_height="64dp"

                            android:orientation="horizontal"
                            android:gravity="center_vertical"

                            android:clickable="true"
                            android:focusable="true"

                            android:background="?attr/selectableItemBackground">

                            <TextView

                                android:layout_width="38dp"
                                android:layout_height="38dp"

                                android:gravity="center"

                                android:text="🕘"

                                android:textSize="21sp"/>

                            <TextView

                                android:layout_width="0dp"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"

                                android:layout_marginStart="12dp"

                                android:text="Lịch sử đặt lịch"

                                android:textSize="15sp"

                                android:textColor="@color/text_primary"/>

                            <TextView

                                android:layout_width="24dp"
                                android:layout_height="wrap_content"

                                android:gravity="center"

                                android:text="›"

                                android:textSize="26sp"

                                android:textColor="@color/text_secondary"/>

                        </LinearLayout>

                        <View

                            android:layout_width="match_parent"
                            android:layout_height="1dp"

                            android:background="@color/border_default"/>

                        <!-- ======================================== -->
                        <!-- 8.3. BARBER YÊU THÍCH                 -->
                        <!-- ======================================== -->

                        <LinearLayout

                            android:id="@+id/rowCustomerProfileFavorites"

                            android:layout_width="match_parent"
                            android:layout_height="64dp"

                            android:orientation="horizontal"
                            android:gravity="center_vertical"

                            android:clickable="true"
                            android:focusable="true"

                            android:background="?attr/selectableItemBackground">

                            <TextView

                                android:layout_width="38dp"
                                android:layout_height="38dp"

                                android:gravity="center"

                                android:text="♡"

                                android:textSize="28sp"

                                android:textColor="@color/primary"/>

                            <TextView

                                android:layout_width="0dp"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"

                                android:layout_marginStart="12dp"

                                android:text="Barber yêu thích"

                                android:textSize="15sp"

                                android:textColor="@color/text_primary"/>

                            <TextView

                                android:layout_width="24dp"
                                android:layout_height="wrap_content"

                                android:gravity="center"

                                android:text="›"

                                android:textSize="26sp"

                                android:textColor="@color/text_secondary"/>

                        </LinearLayout>

                        <View

                            android:layout_width="match_parent"
                            android:layout_height="1dp"

                            android:background="@color/border_default"/>

                        <!-- ======================================== -->
                        <!-- 8.4. THÔNG BÁO                       -->
                        <!-- ======================================== -->

                        <LinearLayout

                            android:id="@+id/rowCustomerProfileNotifications"

                            android:layout_width="match_parent"
                            android:layout_height="64dp"

                            android:orientation="horizontal"
                            android:gravity="center_vertical"

                            android:clickable="true"
                            android:focusable="true"

                            android:background="?attr/selectableItemBackground">

                            <TextView

                                android:layout_width="38dp"
                                android:layout_height="38dp"

                                android:gravity="center"

                                android:text="🔔"

                                android:textSize="21sp"/>

                            <TextView

                                android:layout_width="0dp"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"

                                android:layout_marginStart="12dp"

                                android:text="Thông báo"

                                android:textSize="15sp"

                                android:textColor="@color/text_primary"/>

                            <TextView

                                android:layout_width="24dp"
                                android:layout_height="wrap_content"

                                android:gravity="center"

                                android:text="›"

                                android:textSize="26sp"

                                android:textColor="@color/text_secondary"/>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ======================================== -->
                <!-- 9. NÚT ĐĂNG XUẤT                         -->
                <!-- ======================================== -->

                <com.google.android.material.button.MaterialButton

                    android:id="@+id/btnCustomerProfileLogout"

                    android:layout_width="match_parent"
                    android:layout_height="52dp"

                    android:layout_marginTop="28dp"

                    android:text="Đăng xuất"

                    android:textSize="15sp"
                    android:textStyle="bold"

                    android:textAllCaps="false"

                    android:textColor="@color/primary_dark"

                    app:backgroundTint="@color/surface"

                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp"

                    app:cornerRadius="12dp"

                    app:elevation="0dp"/>

                <!-- ======================================== -->
                <!-- 10. GHI CHÚ CHÂN TRANG                   -->
                <!-- ======================================== -->

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:gravity="center"

                    android:text="BarberUpdate • Hồ sơ khách hàng"

                    android:textSize="12sp"

                    android:textColor="@color/text_secondary"/>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- ======================================== -->
        <!-- 11. TRẠNG THÁI ĐANG TẢI DỮ LIỆU         -->
        <!-- ======================================== -->

        <ProgressBar

            android:id="@+id/progressCustomerProfile"

            android:layout_width="44dp"
            android:layout_height="44dp"

            android:layout_gravity="center"

            android:visibility="gone"

            android:indeterminateTint="@color/primary"/>

        <!-- ======================================== -->
        <!-- 12. TRẠNG THÁI LỖI                     -->
        <!-- ======================================== -->

        <LinearLayout

            android:id="@+id/layoutCustomerProfileError"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical"
            android:gravity="center"

            android:padding="28dp"

            android:background="@color/background"

            android:visibility="gone">

            <!-- 12.1. BIỂU TƯỢNG LỖI -->

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="⚠"

                android:textSize="42sp"

                android:textColor="@color/primary"/>

            <!-- 12.2. TIÊU ĐỀ LỖI -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                android:gravity="center"

                android:text="Không thể tải hồ sơ"

                android:textSize="18sp"
                android:textStyle="bold"

                android:textColor="@color/text_primary"/>

            <!-- 12.3. NỘI DUNG LỖI -->

            <TextView

                android:id="@+id/txtCustomerProfileError"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="10dp"

                android:gravity="center"

                android:text="Đã xảy ra lỗi khi tải thông tin cá nhân."

                android:textSize="14sp"

                android:textColor="@color/text_secondary"/>

            <!-- 12.4. NÚT THỬ LẠI -->

            <com.google.android.material.button.MaterialButton

                android:id="@+id/btnCustomerProfileRetry"

                android:layout_width="180dp"
                android:layout_height="48dp"

                android:layout_marginTop="22dp"

                android:text="Thử lại"

                android:textSize="14sp"
                android:textStyle="bold"

                android:textAllCaps="false"

                android:textColor="@color/surface"

                app:backgroundTint="@color/primary"

                app:cornerRadius="12dp"/>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
