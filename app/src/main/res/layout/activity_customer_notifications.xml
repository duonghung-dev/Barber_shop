<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/customerNotificationsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ========================================
         1. TOOLBAR
         ======================================== -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCustomerNotifications"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        app:title="Thông báo"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_guest_branch_back"
        app:navigationIconTint="@color/primary" />

    <!-- ========================================
         2. PHẦN THÔNG TIN VÀ BỘ LỌC
         ======================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <!-- ========================================
             2.1. TIÊU ĐỀ
             ======================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông báo của bạn"
            android:textColor="@color/text_primary"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- ========================================
             2.2. MÔ TẢ
             ======================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Theo dõi những cập nhật mới nhất về lịch hẹn và dịch vụ của bạn."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <!-- ========================================
             3. THỐNG KÊ THÔNG BÁO
             ======================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/primary_light"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- ========================================
                     3.1. NHÃN THỐNG KÊ
                     ======================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="THÔNG BÁO CHƯA ĐỌC"
                    android:textColor="@color/primary_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- ========================================
                     3.2. SỐ LƯỢNG THÔNG BÁO
                     ======================================== -->

                <TextView
                    android:id="@+id/txtCustomerNotificationsUnreadCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="0 thông báo chưa đọc"
                    android:textColor="@color/primary_dark"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="3 thông báo chưa đọc" />

                <!-- ========================================
                     3.3. GIẢI THÍCH
                     ======================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Nhấn vào thông báo để xem thông tin chi tiết."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================
             4. THANH QUẢN LÝ THÔNG BÁO
             ======================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 4.1. Tiêu đề danh sách -->

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Danh sách thông báo"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ========================================
                 4.2. ĐÁNH DẤU TẤT CẢ ĐÃ ĐỌC
                 ======================================== -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustomerNotificationsMarkAllRead"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Đọc tất cả"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="13sp"
                app:cornerRadius="10dp" />

        </LinearLayout>

        <!-- ========================================
             5. BỘ LỌC THÔNG BÁO
             ======================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- ========================================
                 5.1. BỘ LỌC TẤT CẢ
                 ======================================== -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustomerNotificationsFilterAll"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Tất cả"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp" />

            <!-- ========================================
                 5.2. BỘ LỌC CHƯA ĐỌC
                 ======================================== -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustomerNotificationsFilterUnread"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Chưa đọc"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="14sp"
                app:strokeColor="@color/border_default"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ========================================
         6. VÙNG HIỂN THỊ DANH SÁCH
         ======================================== -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- ========================================
             6.1. RECYCLERVIEW
             ======================================== -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCustomerNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- ========================================
             7. TRẠNG THÁI DANH SÁCH TRỐNG
             ======================================== -->

        <LinearLayout
            android:id="@+id/layoutCustomerNotificationsEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <!-- ========================================
                 7.1. BIỂU TƯỢNG TRỐNG
                 ======================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✉"
                android:textColor="@color/primary"
                android:textSize="52sp"
                android:gravity="center"
                android:contentDescription="Danh sách thông báo trống" />

            <!-- ========================================
                 7.2. TIÊU ĐỀ TRỐNG
                 ======================================== -->

            <TextView
                android:id="@+id/txtCustomerNotificationsEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Chưa có thông báo"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ========================================
                 7.3. MÔ TẢ TRỐNG
                 ======================================== -->

            <TextView
                android:id="@+id/txtCustomerNotificationsEmptyMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Các thông báo mới về lịch hẹn của bạn sẽ xuất hiện tại đây."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <!-- ========================================
             8. TRẠNG THÁI ĐANG TẢI
             ======================================== -->

        <ProgressBar
            android:id="@+id/progressCustomerNotifications"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- ========================================
             9. TRẠNG THÁI LỖI
             ======================================== -->

        <LinearLayout
            android:id="@+id/layoutCustomerNotificationsError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <!-- ========================================
                 9.1. TIÊU ĐỀ LỖI
                 ======================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Không thể tải thông báo"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ========================================
                 9.2. NỘI DUNG LỖI
                 ======================================== -->

            <TextView
                android:id="@+id/txtCustomerNotificationsError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Đã xảy ra lỗi khi đọc dữ liệu thông báo."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- ========================================
                 9.3. NÚT THỬ LẠI
                 ======================================== -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustomerNotificationsRetry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Thử lại"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
