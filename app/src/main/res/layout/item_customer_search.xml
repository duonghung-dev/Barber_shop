<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_default"
    app:strokeWidth="1dp">

    <!-- ========================================
         1. BỐ CỤC CHÍNH CỦA CARD
         ======================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- ========================================
             2. KHUNG BIỂU TƯỢNG KẾT QUẢ
             ======================================== -->

        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_splash_icon">

            <!-- Hình ảnh Chi nhánh / Dịch vụ / Barber -->

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgCustomerSearchResult"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_guest_nav_branch"
                android:contentDescription="Biểu tượng kết quả tìm kiếm"
                app:tint="@color/primary" />

        </FrameLayout>

        <!-- ========================================
             3. KHU VỰC THÔNG TIN KẾT QUẢ
             ======================================== -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <!-- ========================================
                 3.1. LOẠI KẾT QUẢ
                 ======================================== -->

            <TextView
                android:id="@+id/txtCustomerSearchResultType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chi nhánh"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- ========================================
                 3.2. TIÊU ĐỀ KẾT QUẢ
                 ======================================== -->

            <TextView
                android:id="@+id/txtCustomerSearchResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tên kết quả"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- ========================================
                 3.3. THÔNG TIN BỔ SUNG
                 ======================================== -->

            <TextView
                android:id="@+id/txtCustomerSearchResultSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Thông tin bổ sung"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- ========================================
                 3.4. MÔ TẢ KẾT QUẢ
                 ======================================== -->

            <TextView
                android:id="@+id/txtCustomerSearchResultDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Mô tả"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- ========================================
             4. MŨI TÊN XEM CHI TIẾT
             ======================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="›"
            android:contentDescription="Xem chi tiết kết quả"
            android:textColor="@color/primary"
            android:textSize="28sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
