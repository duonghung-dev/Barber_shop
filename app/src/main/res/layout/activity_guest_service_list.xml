<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/serviceListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 1. Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarServices"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        app:title="Danh sách dịch vụ"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_guest_branch_back"
        app:navigationIconTint="@color/primary" />

    <!-- 2. Tiêu đề -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:text="Khám phá dịch vụ"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtServicesSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:text="Chọn dịch vụ phù hợp với phong cách của bạn."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- 3. Tìm kiếm -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilServiceSearch"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="18dp"
        android:hint="Tìm kiếm dịch vụ"
        app:boxBackgroundColor="@color/surface"
        app:startIconDrawable="@drawable/ic_guest_branch_search"
        app:startIconTint="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtServiceSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- 4. Bộ lọc danh mục -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupServices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAllServices"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tất cả"
                android:checkable="true"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHaircut"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cắt tóc"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStyling"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tạo kiểu"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCare"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chăm sóc"
                android:checkable="true" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- 5. Số lượng dịch vụ -->
    <TextView
        android:id="@+id/txtServiceCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="0 dịch vụ"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- 6. Danh sách dịch vụ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerServices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/txtEmptyServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:gravity="center"
            android:text="Không tìm thấy dịch vụ phù hợp."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
