<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/customerBranchListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ========================================
         1. TOOLBAR
         ======================================== -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCustomerBranches"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        app:title="Danh sách chi nhánh"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_guest_branch_back"
        app:navigationIconTint="@color/primary" />

    <!-- ========================================
         2. TIÊU ĐỀ NỘI DUNG
         ======================================== -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:text="Khám phá chi nhánh"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:text="Tìm địa điểm phù hợp để trải nghiệm dịch vụ."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- ========================================
         3. THANH TÌM KIẾM
         ======================================== -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCustomerBranchSearch"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:hint="Tìm kiếm chi nhánh"
        app:boxBackgroundColor="@color/surface"
        app:boxStrokeColor="@color/primary"
        app:startIconDrawable="@drawable/ic_guest_branch_search"
        app:startIconTint="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtCustomerBranchSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ========================================
         4. NHÃN VÀ SỐ LƯỢNG CHI NHÁNH
         ======================================== -->

    <TextView
        android:id="@+id/txtCustomerBranchCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:text="Các chi nhánh (dữ liệu minh họa)"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- ========================================
         5. DANH SÁCH CHI NHÁNH
         ======================================== -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCustomerBranches"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- Khi không tìm thấy kết quả -->
        <TextView
            android:id="@+id/txtEmptyCustomerBranches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:gravity="center"
            android:text="Không tìm thấy chi nhánh phù hợp."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
