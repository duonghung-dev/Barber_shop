<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/customerFavoriteBarbersRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".ui.customer.barber.CustomerFavoriteBarbersActivity">

    <!-- ========================================
         1. TOOLBAR
         ======================================== -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCustomerFavoriteBarbers"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        app:title="Barber yêu thích"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_guest_branch_back"
        app:navigationIconTint="@color/primary" />

    <!-- ========================================
         2. PHẦN GIỚI THIỆU
         ======================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- 2.1. Tiêu đề màn hình -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Barber bạn yêu thích"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 2.2. Mô tả chức năng -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Lưu những Barber phù hợp để dễ dàng tìm lại và đặt lịch vào lần sau."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <!-- ========================================
             3. THẺ THỐNG KÊ BARBER YÊU THÍCH
             ======================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/primary_light"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- 3.1. Nhãn thống kê -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DANH SÁCH YÊU THÍCH"
                    android:textColor="@color/primary_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- 3.2. Tổng số Barber yêu thích -->

                <TextView
                    android:id="@+id/txtCustomerFavoriteBarbersCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 Barber"
                    android:textColor="@color/primary_dark"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="3 Barber" />

                <!-- 3.3. Chú thích -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Các Barber đã được bạn lưu"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================
             4. TIÊU ĐỀ DANH SÁCH
             ======================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Danh sách Barber"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 4.1. Hướng dẫn thao tác -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Chọn Barber để xem chi tiết hoặc bỏ yêu thích."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ========================================
         5. VÙNG HIỂN THỊ DANH SÁCH
         ======================================== -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ========================================
             5.1. RECYCLERVIEW
             ======================================== -->

        <!--
            Danh sách Barber yêu thích.

            Java sẽ:
            - Đọc danh sách yêu thích theo Customer ID
            - Lấy thông tin Barber từ BarberRepository
            - Gắn dữ liệu vào Adapter
            - Xử lý sự kiện chọn Barber
            - Xử lý sự kiện bỏ yêu thích

            Adapter và layout item sẽ được
            xác định ở các bước Java tiếp theo.

            tools:visibility chỉ dùng cho Preview.
        -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCustomerFavoriteBarbers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- ========================================
             5.2. TRẠNG THÁI CHƯA CÓ YÊU THÍCH
             ======================================== -->

        <LinearLayout
            android:id="@+id/layoutEmptyCustomerFavoriteBarbers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- 5.2.1. Biểu tượng trái tim -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♡"
                android:textColor="@color/primary"
                android:textSize="56sp"
                android:gravity="center" />

            <!-- 5.2.2. Tiêu đề trạng thái trống -->

            <TextView
                android:id="@+id/txtEmptyCustomerFavoriteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Chưa có Barber yêu thích"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 5.2.3. Nội dung hướng dẫn -->

            <TextView
                android:id="@+id/txtEmptyCustomerFavoriteMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Hãy khám phá các Barber và nhấn biểu tượng trái tim để lưu vào danh sách yêu thích."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <!-- 5.2.4. Nút khám phá Barber -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustomerFavoriteExploreBarbers"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Khám phá Barber"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <!-- ========================================
             5.3. TRẠNG THÁI ĐANG TẢI
             ======================================== -->

        <ProgressBar
            android:id="@+id/progressCustomerFavoriteBarbers"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- ========================================
             5.4. TRẠNG THÁI LỖI
             ======================================== -->

        <LinearLayout
            android:id="@+id/layoutErrorCustomerFavoriteBarbers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <!-- 5.4.1. Tiêu đề lỗi -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Không thể tải Barber yêu thích"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 5.4.2. Nội dung lỗi -->

            <TextView
                android:id="@+id/txtErrorCustomerFavoriteBarbers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Đã xảy ra lỗi khi đọc danh sách yêu thích."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <!-- 5.4.3. Nút thử lại -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryCustomerFavoriteBarbers"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:text="Thử lại"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
