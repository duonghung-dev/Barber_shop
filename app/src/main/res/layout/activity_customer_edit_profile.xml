<?xml version="1.0" encoding="utf-8"?>

<!-- ======================================== -->
<!-- STT 23 - CUSTOMER EDIT PROFILE          -->
<!-- ======================================== -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/customerEditProfileRoot"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="@color/background">

    <!-- ======================================== -->
    <!-- 1. THANH TIÊU ĐỀ                       -->
    <!-- ======================================== -->

    <LinearLayout

        android:id="@+id/toolbarCustomerEditProfile"

        android:layout_width="match_parent"
        android:layout_height="60dp"

        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:paddingStart="12dp"
        android:paddingEnd="20dp"

        android:background="@color/surface">

        <!-- 1.1. NÚT QUAY LẠI -->

        <ImageButton

            android:id="@+id/btnCustomerEditProfileBack"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:padding="12dp"

            android:src="@drawable/ic_guest_branch_back"

            android:background="?attr/selectableItemBackgroundBorderless"

            android:contentDescription="Quay lại"

            app:tint="@color/text_primary"/>

        <!-- 1.2. TIÊU ĐỀ -->

        <TextView

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:layout_marginStart="8dp"

            android:text="Chỉnh sửa hồ sơ"

            android:textSize="20sp"
            android:textStyle="bold"

            android:textColor="@color/text_primary"/>

    </LinearLayout>

    <!-- ======================================== -->
    <!-- 2. KHUNG NỘI DUNG CHÍNH                 -->
    <!-- ======================================== -->

    <FrameLayout

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1">

        <!-- ======================================== -->
        <!-- 2.1. NỘI DUNG CÓ THỂ CUỘN               -->
        <!-- ======================================== -->

        <androidx.core.widget.NestedScrollView

            android:id="@+id/scrollCustomerEditProfileContent"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:fillViewport="true"

            android:clipToPadding="false">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

                <!-- ======================================== -->
                <!-- 3. THÔNG TIN TÀI KHOẢN HIỆN TẠI          -->
                <!-- ======================================== -->

                <com.google.android.material.card.MaterialCardView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    app:cardBackgroundColor="@color/primary_light"

                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"

                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal"
                        android:gravity="center_vertical"

                        android:padding="20dp">

                        <!-- 3.1. AVATAR -->

                        <com.google.android.material.card.MaterialCardView

                            android:layout_width="64dp"
                            android:layout_height="64dp"

                            app:cardBackgroundColor="@color/primary"

                            app:cardCornerRadius="32dp"

                            app:cardElevation="0dp">

                            <TextView

                                android:id="@+id/txtCustomerEditProfileAvatar"

                                android:layout_width="match_parent"
                                android:layout_height="match_parent"

                                android:gravity="center"

                                android:text="KH"

                                android:textSize="22sp"
                                android:textStyle="bold"

                                android:textColor="@color/surface"

                                android:contentDescription="Ảnh đại diện khách hàng"/>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- 3.2. THÔNG TIN HIỆN TẠI -->

                        <LinearLayout

                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:layout_marginStart="16dp"

                            android:orientation="vertical">

                            <TextView

                                android:id="@+id/txtCustomerEditProfileCurrentName"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:text="Khách hàng"

                                android:textSize="17sp"
                                android:textStyle="bold"

                                android:textColor="@color/text_primary"

                                android:maxLines="2"
                                android:ellipsize="end"/>

                            <TextView

                                android:id="@+id/txtCustomerEditProfileCurrentEmail"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="6dp"

                                android:text="Chưa cập nhật"

                                android:textSize="13sp"

                                android:textColor="@color/text_secondary"

                                android:maxLines="2"
                                android:ellipsize="end"/>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ======================================== -->
                <!-- 4. GIỚI THIỆU BIỂU MẪU                   -->
                <!-- ======================================== -->

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="28dp"

                    android:text="Thông tin cá nhân"

                    android:textSize="18sp"
                    android:textStyle="bold"

                    android:textColor="@color/text_primary"/>

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="18dp"

                    android:text="Cập nhật thông tin để hồ sơ của bạn luôn chính xác."

                    android:textSize="14sp"

                    android:textColor="@color/text_secondary"/>

                <!-- ======================================== -->
                <!-- 5. THẺ BIỂU MẪU CHỈNH SỬA                -->
                <!-- ======================================== -->

                <com.google.android.material.card.MaterialCardView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    app:cardBackgroundColor="@color/surface"

                    app:cardCornerRadius="18dp"

                    app:cardElevation="0dp"

                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="vertical"

                        android:padding="18dp">

                        <!-- ======================================== -->
                        <!-- 5.1. HỌ VÀ TÊN                         -->
                        <!-- ======================================== -->

                        <com.google.android.material.textfield.TextInputLayout

                            android:id="@+id/tilCustomerEditFullName"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:hint="Họ và tên"

                            app:boxBackgroundMode="outline"

                            app:boxStrokeColor="@color/primary"

                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"

                            app:hintTextColor="@color/primary">

                            <com.google.android.material.textfield.TextInputEditText

                                android:id="@+id/edtCustomerEditFullName"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:inputType="textPersonName|textCapWords"

                                android:imeOptions="actionNext"

                                android:maxLines="1"
                                android:maxLength="100"

                                android:autofillHints="name"

                                android:textSize="15sp"

                                android:textColor="@color/text_primary"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- ======================================== -->
                        <!-- 5.2. EMAIL                             -->
                        <!-- ======================================== -->

                        <com.google.android.material.textfield.TextInputLayout

                            android:id="@+id/tilCustomerEditEmail"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="20dp"

                            android:hint="Địa chỉ email"

                            app:boxBackgroundMode="outline"

                            app:boxStrokeColor="@color/primary"

                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"

                            app:hintTextColor="@color/primary">

                            <com.google.android.material.textfield.TextInputEditText

                                android:id="@+id/edtCustomerEditEmail"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:inputType="textEmailAddress"

                                android:imeOptions="actionNext"

                                android:maxLines="1"
                                android:maxLength="254"

                                android:autofillHints="emailAddress"

                                android:textSize="15sp"

                                android:textColor="@color/text_primary"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- ======================================== -->
                        <!-- 5.3. SỐ ĐIỆN THOẠI                     -->
                        <!-- ======================================== -->

                        <com.google.android.material.textfield.TextInputLayout

                            android:id="@+id/tilCustomerEditPhone"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="20dp"

                            android:hint="Số điện thoại"

                            app:boxBackgroundMode="outline"

                            app:boxStrokeColor="@color/primary"

                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"

                            app:hintTextColor="@color/primary"

                            app:helperTextEnabled="true"

                            app:helperText="Không bắt buộc. Nếu nhập, sử dụng số điện thoại Việt Nam gồm 10 chữ số.">

                            <com.google.android.material.textfield.TextInputEditText

                                android:id="@+id/edtCustomerEditPhone"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:inputType="phone"

                                android:digits="0123456789"

                                android:imeOptions="actionDone"

                                android:maxLines="1"
                                android:maxLength="10"

                                android:autofillHints="phone"

                                android:textSize="15sp"

                                android:textColor="@color/text_primary"/>

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ======================================== -->
                <!-- 6. GHI CHÚ CHO CUSTOMER                   -->
                <!-- ======================================== -->

                <com.google.android.material.card.MaterialCardView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="18dp"

                    app:cardBackgroundColor="@color/primary_light"

                    app:cardCornerRadius="12dp"

                    app:cardElevation="0dp">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal"
                        android:gravity="top"

                        android:padding="14dp">

                        <TextView

                            android:layout_width="24dp"
                            android:layout_height="wrap_content"

                            android:text="ⓘ"

                            android:textSize="19sp"
                            android:textStyle="bold"

                            android:textColor="@color/primary_dark"/>

                        <TextView

                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:layout_marginStart="8dp"

                            android:text="Thông tin chỉnh sửa được lưu trong ứng dụng ở giai đoạn FE. Chức năng cập nhật tài khoản trên máy chủ sẽ được tích hợp sau."

                            android:textSize="13sp"

                            android:lineSpacingExtra="3dp"

                            android:textColor="@color/primary_dark"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ======================================== -->
                <!-- 7. NÚT LƯU THAY ĐỔI                       -->
                <!-- ======================================== -->

                <com.google.android.material.button.MaterialButton

                    android:id="@+id/btnCustomerEditProfileSave"

                    android:layout_width="match_parent"
                    android:layout_height="52dp"

                    android:layout_marginTop="28dp"

                    android:text="Lưu thay đổi"

                    android:textSize="15sp"
                    android:textStyle="bold"

                    android:textAllCaps="false"

                    android:textColor="@color/surface"

                    app:backgroundTint="@color/primary"

                    app:cornerRadius="12dp"

                    app:elevation="0dp"/>

                <!-- ======================================== -->
                <!-- 8. NÚT HỦY                              -->
                <!-- ======================================== -->

                <com.google.android.material.button.MaterialButton

                    android:id="@+id/btnCustomerEditProfileCancel"

                    android:layout_width="match_parent"
                    android:layout_height="52dp"

                    android:layout_marginTop="12dp"

                    android:text="Hủy"

                    android:textSize="15sp"
                    android:textStyle="bold"

                    android:textAllCaps="false"

                    android:textColor="@color/primary_dark"

                    app:backgroundTint="@color/surface"

                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp"

                    app:cornerRadius="12dp"

                    app:elevation="0dp"/>

                <!-- ======================================== -->
                <!-- 9. CHÂN TRANG                           -->
                <!-- ======================================== -->

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="24dp"

                    android:gravity="center"

                    android:text="BarberUpdate • Chỉnh sửa hồ sơ"

                    android:textSize="12sp"

                    android:textColor="@color/text_secondary"/>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- ======================================== -->
        <!-- 10. TRẠNG THÁI ĐANG TẢI HỒ SƠ           -->
        <!-- ======================================== -->

        <ProgressBar

            android:id="@+id/progressCustomerEditProfile"

            android:layout_width="44dp"
            android:layout_height="44dp"

            android:layout_gravity="center"

            android:visibility="gone"

            android:indeterminateTint="@color/primary"/>

        <!-- ======================================== -->
        <!-- 11. TRẠNG THÁI LỖI TẢI HỒ SƠ            -->
        <!-- ======================================== -->

        <LinearLayout

            android:id="@+id/layoutCustomerEditProfileError"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical"
            android:gravity="center"

            android:padding="28dp"

            android:background="@color/background"

            android:visibility="gone">

            <!-- 11.1. BIỂU TƯỢNG -->

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="⚠"

                android:textSize="42sp"

                android:textColor="@color/primary"/>

            <!-- 11.2. TIÊU ĐỀ LỖI -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                android:gravity="center"

                android:text="Không thể tải thông tin"

                android:textSize="18sp"
                android:textStyle="bold"

                android:textColor="@color/text_primary"/>

            <!-- 11.3. NỘI DUNG LỖI -->

            <TextView

                android:id="@+id/txtCustomerEditProfileError"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="10dp"

                android:gravity="center"

                android:text="Không thể tải thông tin hồ sơ để chỉnh sửa."

                android:textSize="14sp"

                android:textColor="@color/text_secondary"/>

            <!-- 11.4. NÚT THỬ LẠI -->

            <com.google.android.material.button.MaterialButton

                android:id="@+id/btnCustomerEditProfileRetry"

                android:layout_width="180dp"
                android:layout_height="48dp"

                android:layout_marginTop="22dp"

                android:text="Thử lại"

                android:textSize="14sp"
                android:textStyle="bold"

                android:textAllCaps="false"

                android:textColor="@color/surface"

                app:backgroundTint="@color/primary"

                app:cornerRadius="12dp"/>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
