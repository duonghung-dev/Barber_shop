<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/customerBarberListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ========================================
         1. TOOLBAR
         ======================================== -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCustomerBarbers"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        app:title="Danh sách Barber"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_guest_branch_back"
        app:navigationIconTint="@color/primary" />

    <!-- ========================================
         2. TIÊU ĐỀ
         ======================================== -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:text="Khám phá Barber"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Phụ đề thay đổi theo chi nhánh/Booking -->
    <TextView
        android:id="@+id/txtCustomerBarbersSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:text="Lựa chọn thợ cắt tóc phù hợp với bạn."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- ========================================
         3. THANH TÌM KIẾM
         ======================================== -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCustomerBarberSearch"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:hint="Tìm tên hoặc chuyên môn"
        app:boxBackgroundColor="@color/surface"
        app:startIconDrawable="@drawable/ic_guest_branch_search"
        app:startIconTint="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtCustomerBarberSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ========================================
         4. SỐ LƯỢNG BARBER
         ======================================== -->

    <TextView
        android:id="@+id/txtCustomerBarberCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:text="0 Barber"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- ========================================
         5. DANH SÁCH BARBER
         ======================================== -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- RecyclerView hiển thị Barber -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCustomerBarbers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- Thông báo khi không tìm thấy Barber -->
        <TextView
            android:id="@+id/txtEmptyCustomerBarbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:gravity="center"
            android:text="Không tìm thấy Barber phù hợp."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
