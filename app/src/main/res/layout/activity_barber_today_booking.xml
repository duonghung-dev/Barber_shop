<?xml version="1.0" encoding="utf-8"?>

<!-- ======================================== -->
<!-- BARBERUPDATE - BARBER TODAY BOOKING     -->
<!-- MÀN HÌNH 02: LỊCH HẸN HÔM NAY           -->
<!-- ======================================== -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/barberTodayBookingRoot"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="@color/background">

    <!-- ======================================== -->
    <!-- 1. TOOLBAR                            -->
    <!-- ======================================== -->

    <LinearLayout

        android:id="@+id/toolbarBarberTodayBooking"

        android:layout_width="match_parent"
        android:layout_height="68dp"

        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:paddingStart="12dp"
        android:paddingEnd="12dp"

        android:background="@color/surface">

        <!-- 1.1. NÚT QUAY LẠI -->

        <TextView

            android:id="@+id/btnBarberTodayBack"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:gravity="center"

            android:text="←"
            android:textSize="26sp"

            android:textColor="@color/text_primary"

            android:clickable="true"
            android:focusable="true"

            android:contentDescription="Quay lại"

            android:background="?attr/selectableItemBackgroundBorderless"/>

        <!-- 1.2. TIÊU ĐỀ -->

        <LinearLayout

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:layout_marginStart="6dp"

            android:orientation="vertical">

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Lịch hẹn hôm nay"

                android:textSize="19sp"
                android:textStyle="bold"

                android:textColor="@color/text_primary"/>

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="Quản lý lịch hẹn được phân công"

                android:textSize="12sp"

                android:textColor="@color/text_secondary"/>

        </LinearLayout>

        <!-- 1.3. NÚT LÀM MỚI -->

        <TextView

            android:id="@+id/btnBarberTodayRefresh"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:gravity="center"

            android:text="↻"
            android:textSize="27sp"

            android:textColor="@color/primary"

            android:clickable="true"
            android:focusable="true"

            android:contentDescription="Làm mới danh sách lịch hẹn"

            android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>

    <!-- ======================================== -->
    <!-- 2. ĐƯỜNG PHÂN CÁCH TOOLBAR            -->
    <!-- ======================================== -->

    <View

        android:layout_width="match_parent"
        android:layout_height="1dp"

        android:background="@color/border_default"/>

    <!-- ======================================== -->
    <!-- 3. THẺ TỔNG QUAN HÔM NAY              -->
    <!-- ======================================== -->

    <com.google.android.material.card.MaterialCardView

        android:id="@+id/cardBarberTodayOverview"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"

        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"

        app:cardBackgroundColor="@color/primary_light">

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:gravity="center_vertical"

            android:padding="18dp">

            <!-- 3.1. THÔNG TIN NGÀY -->

            <LinearLayout

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical">

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="Lịch làm việc trong ngày"

                    android:textSize="13sp"

                    android:textColor="@color/text_secondary"/>

                <TextView

                    android:id="@+id/txtBarberTodayBookingDate"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="7dp"

                    android:text="Đang cập nhật ngày..."

                    android:textSize="17sp"
                    android:textStyle="bold"

                    android:textColor="@color/primary_dark"/>

            </LinearLayout>

            <!-- 3.2. TỔNG SỐ BOOKING -->

            <LinearLayout

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="12dp"

                android:orientation="vertical"
                android:gravity="center">

                <TextView

                    android:id="@+id/txtBarberTodayTotalCount"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="—"

                    android:textSize="30sp"
                    android:textStyle="bold"

                    android:textColor="@color/primary_dark"/>

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Lịch hẹn"

                    android:textSize="12sp"

                    android:textColor="@color/text_secondary"/>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ======================================== -->
    <!-- 4. TIÊU ĐỀ BỘ LỌC                    -->
    <!-- ======================================== -->

    <TextView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"

        android:text="Lọc theo trạng thái"

        android:textSize="16sp"
        android:textStyle="bold"

        android:textColor="@color/text_primary"/>

    <!-- ======================================== -->
    <!-- 5. DANH SÁCH BỘ LỌC NGANG             -->
    <!-- ======================================== -->

    <HorizontalScrollView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="12dp"

        android:fillViewport="false"

        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup

            android:id="@+id/chipGroupBarberTodayStatus"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:paddingStart="20dp"
            android:paddingEnd="20dp"

            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true"

            app:chipSpacingHorizontal="8dp">

            <!-- 5.1. TẤT CẢ -->

            <com.google.android.material.chip.Chip

                android:id="@+id/chipBarberTodayAll"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Tất cả"

                android:textSize="13sp"

                android:checked="true"

                android:checkable="true"

                app:checkedIconVisible="true"/>

            <!-- 5.2. CHỜ XÁC NHẬN -->

            <com.google.android.material.chip.Chip

                android:id="@+id/chipBarberTodayPending"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Chờ xác nhận"

                android:textSize="13sp"

                android:checkable="true"

                app:checkedIconVisible="true"/>

            <!-- 5.3. ĐÃ XÁC NHẬN -->

            <com.google.android.material.chip.Chip

                android:id="@+id/chipBarberTodayConfirmed"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Đã xác nhận"

                android:textSize="13sp"

                android:checkable="true"

                app:checkedIconVisible="true"/>

            <!-- 5.4. HOÀN THÀNH -->

            <com.google.android.material.chip.Chip

                android:id="@+id/chipBarberTodayCompleted"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Hoàn thành"

                android:textSize="13sp"

                android:checkable="true"

                app:checkedIconVisible="true"/>

            <!-- 5.5. ĐÃ HỦY -->

            <com.google.android.material.chip.Chip

                android:id="@+id/chipBarberTodayCancelled"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Đã hủy"

                android:textSize="13sp"

                android:checkable="true"

                app:checkedIconVisible="true"/>

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- ======================================== -->
    <!-- 6. THÔNG TIN DANH SÁCH                 -->
    <!-- ======================================== -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"

        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 6.1. SỐ KẾT QUẢ THEO BỘ LỌC -->

        <TextView

            android:id="@+id/txtBarberTodayResultCount"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="Chưa tải danh sách"

            android:textSize="14sp"
            android:textStyle="bold"

            android:textColor="@color/text_primary"/>

        <!-- 6.2. GỢI Ý THAO TÁC -->

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginStart="10dp"

            android:text="Chọn để xem chi tiết"

            android:textSize="11sp"

            android:textColor="@color/text_secondary"/>

    </LinearLayout>

    <!-- ======================================== -->
    <!-- 7. KHU VỰC DANH SÁCH BOOKING          -->
    <!-- ======================================== -->

    <FrameLayout

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1">

        <!-- ======================================== -->
        <!-- 7.1. RECYCLERVIEW DANH SÁCH BOOKING     -->
        <!-- ======================================== -->

        <!--
            RecyclerView chỉ hiển thị Booking
            được phân công cho Barber hiện tại
            và có ngày hẹn là ngày hôm nay.

            Adapter sẽ được xây dựng ở bước Java.

            Không sử dụng dữ liệu Booking giả.
        -->

        <androidx.recyclerview.widget.RecyclerView

            android:id="@+id/recyclerBarberTodayBookings"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"

            android:clipToPadding="false"

            android:scrollbars="vertical"

            android:visibility="gone"/>

        <!-- ======================================== -->
        <!-- 7.2. TRẠNG THÁI DANH SÁCH TRỐNG         -->
        <!-- ======================================== -->

        <LinearLayout

            android:id="@+id/layoutBarberTodayEmpty"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical"
            android:gravity="center"

            android:padding="28dp">

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="📅"

                android:textSize="44sp"/>

            <TextView

                android:id="@+id/txtBarberTodayEmptyTitle"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                android:gravity="center"

                android:text="Chưa tải dữ liệu lịch hẹn"

                android:textSize="17sp"
                android:textStyle="bold"

                android:textColor="@color/text_primary"/>

            <TextView

                android:id="@+id/txtBarberTodayEmptyMessage"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="9dp"

                android:gravity="center"

                android:text="Danh sách lịch hẹn hôm nay sẽ được hiển thị tại đây."

                android:textSize="13sp"

                android:lineSpacingExtra="4dp"

                android:textColor="@color/text_secondary"/>

            <!-- NÚT LÀM MỚI KHI DANH SÁCH TRỐNG -->

            <com.google.android.material.button.MaterialButton

                android:id="@+id/btnBarberTodayEmptyRefresh"

                android:layout_width="wrap_content"
                android:layout_height="48dp"

                android:layout_marginTop="20dp"

                android:minWidth="150dp"

                android:text="Làm mới"

                android:textSize="14sp"
                android:textStyle="bold"

                android:textAllCaps="false"

                android:textColor="@color/primary_dark"

                app:backgroundTint="@color/primary_light"

                app:cornerRadius="12dp"

                app:elevation="0dp"/>

        </LinearLayout>

        <!-- ======================================== -->
        <!-- 7.3. TRẠNG THÁI ĐANG TẢI DỮ LIỆU        -->
        <!-- ======================================== -->

        <LinearLayout

            android:id="@+id/layoutBarberTodayLoading"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical"
            android:gravity="center"

            android:padding="24dp"

            android:background="@color/background"

            android:visibility="gone">

            <ProgressBar

                android:id="@+id/progressBarberTodayBookings"

                android:layout_width="42dp"
                android:layout_height="42dp"

                android:indeterminateTint="@color/primary"/>

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="15dp"

                android:gravity="center"

                android:text="Đang tải lịch hẹn..."

                android:textSize="14sp"

                android:textColor="@color/text_secondary"/>

        </LinearLayout>

        <!-- ======================================== -->
        <!-- 7.4. TRẠNG THÁI LỖI                   -->
        <!-- ======================================== -->

        <LinearLayout

            android:id="@+id/layoutBarberTodayError"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical"
            android:gravity="center"

            android:padding="28dp"

            android:background="@color/background"

            android:visibility="gone">

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="⚠"

                android:textSize="42sp"

                android:textColor="@color/primary"/>

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="15dp"

                android:gravity="center"

                android:text="Không thể tải lịch hẹn"

                android:textSize="18sp"
                android:textStyle="bold"

                android:textColor="@color/text_primary"/>

            <TextView

                android:id="@+id/txtBarberTodayError"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="10dp"

                android:gravity="center"

                android:text="Đã xảy ra lỗi khi tải dữ liệu lịch hẹn. Vui lòng thử lại."

                android:textSize="14sp"

                android:lineSpacingExtra="4dp"

                android:textColor="@color/text_secondary"/>

            <com.google.android.material.button.MaterialButton

                android:id="@+id/btnBarberTodayRetry"

                android:layout_width="180dp"
                android:layout_height="48dp"

                android:layout_marginTop="22dp"

                android:text="Thử lại"

                android:textSize="14sp"
                android:textStyle="bold"

                android:textAllCaps="false"

                android:textColor="@color/surface"

                app:backgroundTint="@color/primary"

                app:cornerRadius="12dp"/>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
